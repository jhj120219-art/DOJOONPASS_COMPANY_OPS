# Company Ops environment template (docs/04_NOTION_SYNC_SPEC.md §40-41,
# docs/13_NOTION_ENVIRONMENT_SETUP.md §3-6).
#
# Copy this file to .env and fill in real values there. This file itself
# must never contain a real value — see tests/test_repository_hygiene.py
# and tests/test_spec_conformance.py, which enforce that every KEY= line
# below stays empty.
#
# This project does not load .env automatically (no python-dotenv): export
# these in the shell, or have the launching script load .env itself, before
# running any entrypoint. All four read the environment directly:
#
# **A shell export is not enough for a SCHEDULED run.** A scheduled task
# inherits no interactive shell, so a value exported in a shell reaches the
# run you start by hand and nothing else: the tool works when you try it,
# and the scheduled run keeps reporting Notion as '미설정' while still
# exiting 0. For anything install_runner_task.ps1 or
# install_publish_task.ps1 schedules, the NOTION_* values must be in the
# USER environment -- the same mechanism the note at the bottom of this
# header describes for install_agent_task.ps1's three variables, which only
# those installers' refusal to accept a secret keeps from being automatic.
# The command and a scope-by-scope check are in
# docs/13_NOTION_ENVIRONMENT_SETUP.md section 2.1.
#
#   run_company_ops.py   COMPANY_OPS_HISTORY_START_DATE, NOTION_*
#   run_agent.py         COMPANY_OPS_PROFILE, COMPANY_OPS_AGENT_*
#   init_notion.py       NOTION_*
#   ops_status.py        COMPANY_OPS_AGENT_START_DATE (optional)
#   dashboard_server.py  COMPANY_OPS_DASHBOARD_PORT (optional)
#   publish_control_tower.py  NOTION_*
#
# scripts/install_agent_task.ps1 persists the three COMPANY_OPS_AGENT/PROFILE
# values into the user environment, because a scheduled task does not inherit
# an interactive shell's variables.
#
# tests/test_repository_hygiene.py checks that this file and the code agree:
# every variable read anywhere must be listed below, and vice versa.

# Required for Notion Sync (src/notion/config.py). Without both, Notion
# Sync and the Operations Dashboard are skipped entirely — not an error.
NOTION_API_TOKEN=
NOTION_PROJECTS_DATABASE_ID=

# Optional. Enables the Operations Dashboard (CEO Decision (4)) on top of
# Notion Sync. Unset -> Sync still runs, Dashboard recording is skipped.
NOTION_OPS_RUNS_DATABASE_ID=

# Required by run_company_ops.py. Company History start date; never
# guessed (docs/07 §50). Format: YYYY-MM-DD.
COMPANY_OPS_HISTORY_START_DATE=

# Selects a Desktop profile (src/reporter/profiles.py) for the Reporter and
# the Multi-Desktop Agent: one of DESKTOP_1, DESKTOP_2, DESKTOP_3,
# DESKTOP_4. The role is NOT configured separately -- it comes from the
# profile table, which is docs/02 section 8's own source->role table.
# Required by run_agent.py; optional for run_company_ops.py.
COMPANY_OPS_PROFILE=

# Required by run_agent.py. The OneDrive Sync Folder this Desktop writes
# Events into, and Desktop 4 mirrors as its own transport/ directory.
#
# Required by run_agent.py and by nothing else. Unset, this Desktop cannot
# send its Events -- and the rest still runs: Company History, Daily,
# Backup, Notion Sync and the Dashboard all work on what has already been
# collected, and the D+1 report answers "what changed yesterday" from the
# local git repository instead (src/delivery/git_activity.py). docs/13
# section 2.0.1 has the table; docs/15 has the reasoning.
COMPANY_OPS_AGENT_SYNC_FOLDER=

# Required by run_agent.py. The first date this Desktop should collect on a
# first-ever run; never guessed (docs/07 section 50). Format: YYYY-MM-DD.
# Separate from COMPANY_OPS_HISTORY_START_DATE because a Desktop can start
# reporting later than Company History itself began.
COMPANY_OPS_AGENT_START_DATE=

# Optional. The loopback port dashboard_server.py listens on. Unset -> 8765.
# It exists for the one thing an operator cannot work around -- another
# process already holding that port -- and nothing else about that tool is
# configurable: it binds 127.0.0.1 only, by design (see its module
# docstring), and answers GET only.
COMPANY_OPS_DASHBOARD_PORT=
